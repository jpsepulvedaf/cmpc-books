# ─────────────────────────────────────────────────────────────────────────────
# CMPC Libros — environment template
# Copy to `.env` (repo root) and adjust. Never commit the real `.env`.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
API_PORT=3000
WEB_PORT=5173

# PostgreSQL (Docker service `db` maps host 5433 → container 5432)
POSTGRES_USER=cmpc
POSTGRES_PASSWORD=cmpc
POSTGRES_DB=cmpc_books
# El contenedor de la API usa su propia URL interna (db:5432). Este valor solo
# se usa al ejecutar scripts npm desde el host (migrate/seed/dev) contra el
# PostgreSQL del compose, publicado en el host en el puerto 5433.
DATABASE_URL=postgresql://cmpc:cmpc@localhost:5433/cmpc_books?schema=public

# Auth
JWT_SECRET=changeme-super-secret-please-rotate
JWT_EXPIRES_IN=12h

# API docs — enable in dev, disable in production
SWAGGER_ENABLED=true