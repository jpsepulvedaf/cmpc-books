# ─────────────────────────────────────────────────────────────────────────────
# CMPC Libros — environment template
# Copy to `.env` (repo root) and adjust. Never commit the real `.env`.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
API_PORT=3000
WEB_PORT=5173

# PostgreSQL (Docker service `db` publishes on host port ${DB_HOST_PORT})
POSTGRES_USER=cmpc
POSTGRES_PASSWORD=cmpc
POSTGRES_DB=cmpc_books
# Host port where compose exposes PostgreSQL (default 5433). If you change it,
# update DATABASE_URL below to the same port.
DB_HOST_PORT=5433
# El contenedor de la API usa su propia URL interna (db:5432). Este valor se
# usa al ejecutar scripts npm desde el host (migrate/seed/dev) y se respeta
# aunque definas otro puerto, p. ej. DB_HOST_PORT=5455 + este =5433→5455.
DATABASE_URL=postgresql://cmpc:cmpc@localhost:5433/cmpc_books?schema=public

# Auth
JWT_SECRET=changeme-super-secret-please-rotate
JWT_EXPIRES_IN=12h

# API docs — enable in dev, disable in production
SWAGGER_ENABLED=true