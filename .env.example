# ─────────────────────────────────────────────────────────────────────────────
# CMPC Libros — environment template
# Copy to `.env` (repo root) and adjust. Never commit the real `.env`.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
API_PORT=3000
WEB_PORT=5173

# PostgreSQL (Docker service `db`)
POSTGRES_USER=cmpc
POSTGRES_PASSWORD=cmpc
POSTGRES_DB=cmpc_books
DATABASE_URL=postgresql://cmpc:cmpc@localhost:5432/cmpc_books?schema=public

# Auth
JWT_SECRET=changeme-super-secret-please-rotate
JWT_EXPIRES_IN=12h

# API docs — enable in dev, disable in production
SWAGGER_ENABLED=true