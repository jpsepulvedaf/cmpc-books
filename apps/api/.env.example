# API environment template — copy to apps/api/.env
NODE_ENV=development
API_PORT=3000

# Host puerto del PostgreSQL de compose (default 5433); si cambias DB_HOST_PORT
# en el .env raíz, alinea aquí el puerto de DATABASE_URL.
DATABASE_URL=postgresql://cmpc:cmpc@localhost:5433/cmpc_books?schema=public

JWT_SECRET=changeme-super-secret-please-rotate
JWT_EXPIRES_IN=12h

# Set to false in production: Swagger module is not registered
SWAGGER_ENABLED=true